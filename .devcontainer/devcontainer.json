// For format details, see https://aka.ms/devcontainer.json
{
	"name": "build-environment",

	// Runs on the host before building, to record the host's user and docker group IDs
	"initializeCommand": ".devcontainer/initialize.sh",

	"dockerComposeFile": "docker-compose.yml",
	"service": "development",
	"workspaceFolder": "/workspaces/build-environment",

	"remoteUser": "leb",
	// The Dockerfile already matches leb to the host user with update_user_group_ids.sh
	"updateRemoteUserUID": false
}
